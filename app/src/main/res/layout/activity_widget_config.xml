<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="ارزبان"
            android:src="@drawable/ic_arzban"/>

        <TextView
            android:id="@+id/config_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="دارایی‌های موردنظر را برای نمایش روی صفحه اصلی انتخاب کنید."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مورد اول"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>
                <Spinner
                    android:id="@+id/config_asset_1"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/config_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مورد دوم"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>
                <Spinner
                    android:id="@+id/config_asset_2"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/config_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مورد سوم"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>
                <Spinner
                    android:id="@+id/config_asset_3"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"/>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/config_save_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/button_primary"
            android:text="افزودن ویجت"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>
