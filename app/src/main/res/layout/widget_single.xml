<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="ارزبان"
            android:src="@drawable/ic_arzban"/>

        <TextView
            android:id="@+id/widget_asset1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/widget_secondary"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_refresh"
            android:contentDescription="بروزرسانی"
            android:padding="7dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/widget_primary"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_asset1_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="start"
        android:textColor="@color/widget_primary"
        android:textDirection="ltr"
        android:textSize="27sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/widget_asset1_change"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/widget_tertiary"
        android:textDirection="ltr"
        android:textSize="12sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/widget_tertiary"
        android:textSize="9sp"/>
</LinearLayout>
