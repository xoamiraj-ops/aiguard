<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:contentDescription="لوگوی ارزبان"
                android:scaleType="fitCenter"
                android:src="@drawable/arzban_brand_icon"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="همیشه یک قدم جلوتر"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/market_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="○ وضعیت بازار نامشخص"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/last_updated_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="هنوز نرخ بازار دریافت نشده"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/service_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_status"
            android:padding="13dp"
            android:text="○ بررسی خودکار کانال خاموش است"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_error"
            android:padding="11dp"
            android:textColor="#C65A52"
            android:textSize="12sp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/start_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/button_primary"
            android:text="فعال‌سازی بررسی خودکار"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/refresh_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/button_secondary"
            android:text="بررسی کانال همین حالا"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/stop_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/button_secondary"
            android:text="توقف بررسی خودکار"
            android:textAllCaps="false"
            android:textColor="#C65A52"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ویجت‌های ارزبان"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="2dp"
                android:text="سه مدل ویجت مستقل دارید: تک‌قیمت، دو‌قیمت و سه‌قیمت. هنگام افزودن ویجت از صفحه اصلی گوشی، دارایی‌های دلخواه همان ویجت را انتخاب می‌کنید."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ارزها"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/currency_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="vertical"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="طلا و فلزات"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/gold_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="vertical"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="سکه"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/coin_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="vertical"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_status"
            android:lineSpacingExtra="3dp"
            android:padding="13dp"
            android:text="نرخ‌ها صرفاً جهت اطلاع هستند و پیشنهاد خرید، فروش یا سرمایه‌گذاری محسوب نمی‌شوند."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/privacy_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@android:color/transparent"
            android:text="حریم خصوصی و منابع داده"
            android:textAllCaps="false"
            android:textColor="@color/link_text"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/notification_settings_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@android:color/transparent"
            android:text="تنظیمات اعلان برنامه"
            android:textAllCaps="false"
            android:textColor="@color/link_text"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="منبع قیمت: کانال عمومی تلگرام @DO_L4 • تومان"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"/>
    </LinearLayout>
</ScrollView>
